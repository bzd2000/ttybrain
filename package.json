{
  "name": "opentui-app",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "test": "bun test",
    "typecheck": "bun check",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "npm run build:node && node --experimental-ffi dist-node/index.js",
    "pm": "bun src/bin/pm.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@types/bun": "latest",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.16"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "solid-js": "^1.9",
    "kysely": "0.28.18",
    "typebox": "1.4.3"
  },
  "bin": {
    "pm": "dist-node/bin/pm.js"
  }
}
